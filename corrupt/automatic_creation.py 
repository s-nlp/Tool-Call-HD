    #sampling of the space of the json
    def get_random_focused_schema(self, schema_dict: dict):
        """
        DUMB MASKING: Picks a single top-level field and nulls the rest.
        """
        schema = deepcopy(schema_dict)
        
        fields = list(schema['properties'].keys())
        
        target_field = random.choice(fields)
        print(f"Randomly selected Dumb Focus: {target_field}")
        
        for field_name in fields:
            if field_name != target_field:
                schema['properties'][field_name] = {"type": "null"}
                
        return target_field, json.dumps(schema)
    # cascade generation 
    def get_all_leaf_paths(self, schema: dict, current_path: str = "") -> list:
        """Recursively finds all possible end-point fields in the schema"""
        paths = []
        node_type = schema.get("type", "object")
        
        if node_type == "object" and "properties" in schema:
            for key, val in schema["properties"].items():
                next_path = f"{current_path}.{key}" if current_path else key
                paths.extend(self.get_all_leaf_paths(val, next_path))
                
        elif node_type == "array" and "items" in schema:
            next_path = f"{current_path}.items" if current_path else "items"
            paths.extend(self.get_all_leaf_paths(schema["items"], next_path))
            
        else:
            paths.append(current_path)
            
        return paths
    def apply_cascade_mask(self, schema: dict, target_path: str) -> dict:
        """Recursively sets everything to null EXCEPT the path to the target"""
        target_parts = target_path.split(".")
        
        def _mask_node(node, current_parts):
            # If we went down the wrong path, shut it down
            if current_parts != target_parts[:len(current_parts)]:
                return {"type": "null"}
                
            # If we reached the exact target, leave it completely alone!
            if current_parts == target_parts:
                return deepcopy(node)
                
            # Otherwise, we are on the correct path, keep digging
            node_copy = deepcopy(node)
            node_type = node_copy.get("type", "object")
            
            if node_type == "object" and "properties" in node_copy:
                for key, val in node_copy["properties"].items():
                    node_copy["properties"][key] = _mask_node(val, current_parts + [key])
                    
            elif node_type == "array" and "items" in node_copy:
                node_copy["items"] = _mask_node(node_copy["items"], current_parts + ["items"])
                
            return node_copy

        return _mask_node(schema, [])
    def create_random_cascade_schema(self,schema_dict: dict) -> tuple[str, str]:
        """
        MAIN FUNCTION:
        Takes an inferred schema dict, picks a random target, masks everything else, 
        and returns the target name and the final guided_json string.
        output:
            chosen_target (str),  json.dumps(masked_schema) (str)
        """
        #This will find all possible targets
        all_paths = self.get_all_leaf_paths(schema_dict)
        
        #Here we literally pick the random target
        chosen_target = random.choice(all_paths)
        
        # and we get the mask scheme which is needed for generation
        masked_schema = self.apply_cascade_mask(schema_dict, chosen_target)
        
        return chosen_target, json.dumps(masked_schema)
    #------------------------------------------------------
    # Generation functions 
    #------------------------------------------------------


    def type1_auto(self, tool_response: str, prompt: str, 
                   guided_schema_dict: Optional[dict] = None, 
                   how: Literal['random_one', 'all'] = "random_one", 
                   howhow: Literal['smart', 'dumb'] = 'dumb',  
                   batch_size: Literal['auto'] | int = 'auto'): 
        """
        Generates a hallucination based on the tool response.
        """
        if guided_schema_dict is not None:
            schema_dict = guided_schema_dict
        else:
            schema_dict = self.get_guided_schema_for_tool(tool_response)
            
        
        if howhow == "smart": 
            # Smart: Cascade hallucinations (Tree logic)
            target, final_json_str = self.create_random_cascade_schema(schema_dict)
        elif howhow == 'dumb':
            # Dumb: Single cell hallucination
            target, final_json_str = self.get_random_focused_schema(schema_dict)

        try:
            from vllm.sampling_params import GuidedDecodingParams
            sampling_params = SamplingParams(
                guided_decoding=GuidedDecodingParams(json=final_json_str),
                temperature=0.8,
                max_tokens=500
            )
        except (ImportError, TypeError):
            try:
                sampling_params = SamplingParams(guided_json=final_json_str, temperature=0.8, max_tokens=500)
            except TypeError:
                sampling_params = SamplingParams(temperature=0.8, max_tokens=500)
                
        output = self.llm.generate([prompt], sampling_params=sampling_params)
        return output[0].outputs[0].text
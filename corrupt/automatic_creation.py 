    # Function generating the guided_json
    def build_dynamic_schema(self,data, is_root=True):
        """
        The function to extract the pydantic guided_scheme from the str
        """
        if isinstance(data, dict):
            properties = {}
            for key, value in data.items():
                #Lock the top-level tool name so it cannot be hallucinated (oppsie daisy))
                if is_root and key == "name" and isinstance(value, str):
                    properties[key] = {
                        "type": "string", 
                        "enum": [value]  
                    }
                else:
                    properties[key] = self.build_dynamic_schema(value, is_root=False)
                    
            return {
                "type": "object",
                "properties": properties,
                "required": list(data.keys()),
                "additionalProperties": False # Prevents vLLM from making up new keys
            }
            
        elif isinstance(data, list):
            if len(data) > 0:
                item_schema = self.build_dynamic_schema(data[0], is_root=False)
            else:
                item_schema = {"type": "string"} # Fallback for empty arrays
                
            return {
                "type": "array",
                "items": item_schema
            }
            
        elif isinstance(data, str):
            return {"type": "string"}
        elif isinstance(data, bool):
            return {"type": "boolean"}
        elif isinstance(data, int):
            return {"type": "integer"}
        elif isinstance(data, float):
            return {"type": "number"}
        elif data is None:
            return {"type": "null"}
        else:
            return {"type": "string"}

    def get_guided_schema_for_tool(self, tool_call_json_str:str) -> json:
        """
        Takes a raw JSON string and returns a vLLM-ready schema string.
        Input: json as a string
        Ouptut: guided_scheme for pydantic
        """
        parsed_json = json.loads(tool_call_json_str)
        schema_dict = self.build_dynamic_schema(parsed_json, is_root=True)
        # return json.dumps(schema_dict)
        return schema_dict
    # function to show the pretty way of the json for presentaions
    def print_schema_tree(self, schema: dict, name="root", indent="", defs=None, is_last=True, current_path=""):
        """Recursively parses any JSON schema and prints a beautiful tree."""
        if defs is None:
            defs = schema.get("$defs", {})

        
        if "$ref" in schema:
            ref_name = schema["$ref"].split("/")[-1]
            schema = defs[ref_name]

        marker = "└── " if is_last else "├── "
        node_type = schema.get("type", "object")
        
        # Print the current node with its path
        path_display = f"  [Path: {current_path}]" if current_path else ""
        print(f"{indent}{marker}{name} ({node_type}){path_display}")
        
        indent += "    " if is_last else "│   "
        
        # If it's an Object, go through its properties
        if node_type == "object" and "properties" in schema:
            props = schema["properties"]
            keys = list(props.keys())
            for i, k in enumerate(keys):
                next_path = f"{current_path}.{k}" if current_path else k
                self.print_schema_tree(props[k], k, indent, defs, i == len(keys)-1, next_path)
                
        elif node_type == "array" and "items" in schema:
            next_path = f"{current_path}.items" if current_path else "items"
            self.print_schema_tree(schema["items"], "items", indent, defs, True, next_path)

